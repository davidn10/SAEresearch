cd "D:\david\SAE\SAE_research_with_Melany\MEX"


clear all
set more off

/*=========================================
 Defining globals
 *=========================================*/

global currdata "D:\david\SAE\SAE_research_with_Melany\MEX\2010\full_census_new"
global rawsamples "$currdata\rawsamples_full\"
global census "$currdata\census\"
global results "$currdata\results\effective_sample_size" 
global simcensus "$currdata\simcensus\"

set seed 648743


* rescaled weights 
putexcel set "$results\ESS_rescaled", replace
forvalues i=1(1)100{
use "$rawsamples\selected\sample_`i'.dta",replace 
egen meanFACTOR=mean(FACTOR), by(mun_id)
replace FACTOR=FACTOR/meanFACTOR
collapse (rawsum) FACTOR, by(mun_id)
gen FACTORsq=FACTOR^2 
sum FACTOR 
local num=r(sum)^2 
sum FACTORsq 
local denom=r(sum)
local ESS=`num'/`denom'
putexcel A`i'=`ESS'
} 

* no weights 

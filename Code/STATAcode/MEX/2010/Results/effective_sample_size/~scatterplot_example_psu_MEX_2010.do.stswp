global currdata "D:\david\SAE\SAE_research_with_Melany\MEX\2010\full_census_new"
global rawsamples "$currdata\rawsamples_full\"
global census "$currdata\census\"
global results "$currdata\results\effective_sample_size" 
global simcensus "$currdata\simcensus\"

drop _all 
tempfile tempraw temprescale  
gen sim=. 


global model "$currdata\results\results_ebp_norescale\unit\model_h"
local model99 ""
use "$model\coef_sample_99", replace 
drop in 1 
forvalues j=1(1)`=_N' {
local model99="`model99'"+names[`j']+" "	
}

/*
use "$rawsamples\selected\sample_99.dta", replace 
g popwt_99=FACTOR*hhsize
egen mean_popwt_99=mean(popwt_99), by(mun_id)
gen popwt_99_resc=popwt_99/mean_popwt_99


collapse (mean) ln_pchinc_99=ln_pchinc (rawsum) popwt_99* [aw=popwt_99], by(mun_id psu_id)
save "$results\Ybar_99_bypsu_MEX_2010", replace 
 

use "$currdata/rawdata/census_proc_MEX_2010.dta", replace 
g ln_pchinc=ln(pchinc)
g popwt=FACTOR*hhsize
gen hhsize2=hhsize^2 
tab ENT, gen(state_)
collapse (mean) ln_pchinc `model99' (rawsum) popwt [pw=popwt],by(mun_id psu_id)
merge 1:n mun_id psu_id using "$results\Ybar_99_bypsu_MEX_2010",  keep(1 3) nogen 
label var ln_pchinc_99 "Sample log pci"

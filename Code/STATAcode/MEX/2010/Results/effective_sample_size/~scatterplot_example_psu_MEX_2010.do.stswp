*/ 

use "$results/scatterplot_example", replace 
rename ln_pchinc y_true 
regress ln_pchinc_99 `model99' [pw=popwt_99_resc]
predict yhat_resc, xb 
label var yhat_resc "Rescaled weights"
regress ln_pchinc_99 `model99' [pw=popwt_99]
predict yhat_norescale 
label var yhat_norescale "Raw weights"
regress y_true `model99' if ln_pchinc_99<. [pw=popwt]
predict yhat_sample  
regress y_true `model99' [pw=popwt]
predict yhat_pop

label var yhat_pop "Population prediction"
local width ""
twoway  (scatter y_true yhat_pop,msymbol(oh)) (lfit y_true yhat_pop, lpattern(longdash) lwidth(`width')) (lfit y_true yhat_resc,lpattern(dash) lwidth(`width')) (lfit y_true yhat_norescale,lwidth(`width')), ylabel(0(1)12) xlabel(5(1)9) legend(order(2 3 4) label(2 "Population prediction (rho=0.71)") label(3 "Rescaled weights (rho=0.69)") label(4 "Raw weights (rho=0.54)") position(3)) ytitle("True mean PCI") xtitle("Predicted mean PCI")

*twoway  (scatter yhat_pop y_true) (lfit yhat_pop y_true) (lfit yhat_resc y_true) (lfit yhat_norescale y_true), ylabel(0(1)12) xlabel(0(1)12) legend(order(2 3 4) label(2 "Population prediction") label(3 "Rescaled weights") label(4 "Raw weights")) xtitle("True mean PCI") ytitle("Predicted mean PCI")

correlate yhat_pop y_true 
correlate yhat_sample y_true 
correlate yhat_norescale y_true 
correlate yhat_resc y_true 



* (scatter ln_pchinc_99 hhsize) (scatter ln_pchinc hhsize)



xx



drop _all 
global results "$currdata\results\results_ebp\"
import excel "$results\rankcorr_EBP_unit_h"
keep A 
rename A spearman_rescaled 
drop in 1/3 
gen sim=_n 
save "$currdata\results\effective_sample_size\spearman_rescaled_MEX_2010", replace 

global results "$currdata\results\results_ebp_norescale\"
drop _all 
import excel "$results\rankcorr_EBP_unit_norescale"
keep A 
rename A spearman_norescale 
drop in 1/3 
gen sim=_n 
 
merge 1:1 sim using "$currdata\results\effective_sample_size\spearman_rescaled_MEX_2010", assert(3) nogen 
merge 1:1 sim using "$currdata\results\effective_sample_size\Var_Y_MEX_2010", assert(3) nogen 


reshape long spearman var_y mean_y, i(sim) j(scale) string

gen rescaled=scale=="_rescaled" 
gen spearman_rescaled=spearman if rescaled==1 
gen spearman_norescale=spearman if rescaled==0 
label var var_y "variance in log PCI"
label var spearman_rescaled "Rescaled weights"
label var spearman_norescale "Raw weights"
global results "$currdata\results\effective_sample_size" 

twoway (scatter spearman_rescaled spearman_norescale var_y, msymbol(oh X)) (lfit spearman_norescale var_y,lcolor(red)) (lfit spearman_rescale var_y, lcolor(blue)),  ylabel(0.65(0.05)0.95) ymtick(0.65(0.05)0.95) legend(position(bottom)) ytitle("Spearman Rank Correlation") saving($results/var_y_scatter_MEX_2010, replace) legend(order(1 2) rows(1) size(small)) title("Mexico 2010")
table rescaled, statistic(mean var_y mean_y)
su spearman_norescale 
/*
use "D:\david\SAEresearch\Code\STATAcode\MEX\2010\Results\poverty_simulations\census_comparison_1", replace 

scalar pline=962.8 
gen p0_baseline=pchinc<pline 
gen p1_baseline=(pline-pchinc)/pline if pchinc<pline 
replace p1_baseline=0 if pchinc>=pline 

gen fgt_true=fgt0_m

* foreach threshold of numlist 5(5)50 {
 foreach threshold of numlist 46 {
foreach method in true brf fh ebp_unit ell ebp_context ebp_area_context subarea {

* beneficiaries are those in X percent of poorest areas, so calculate 100-X percentile cutoff 
local oneminusthreshold=100-`threshold'
_pctile fgt_`method' [fw=hhsize], p(`oneminusthreshold')
dis r(r1)
if `threshold'==5 {
		local threshold="05"
}

gen beneficiary_`method'__`threshold'=fgt_`method'>r(r1)
su beneficiary_`method'__`threshold' [aw=hhsize]

gen pchinc_`method'__`threshold'=pchinc 
replace pchinc_`method'__`threshold'=pchinc_`method'__`threshold'+0.1*pline if beneficiary_`method'__`threshold'==1 
gen p0_`method'__`threshold'=pchinc_`method'__`threshold'<pline 
gen p1_`method'__`threshold'=(pline-pchinc_`method'__`threshold')/pline if pchinc_`method'__`threshold'<pline
replace p1_`method'__`threshold'=0 if pchinc_`method'__`threshold'>=pline 
} 
su p0_baseline p0_*__`threshold' [aw=hhsize]
su p1_baseline p1_*__`threshold'* [aw=hhsize]
 }
collapse (mean) p0* p1* [aw=hhsize]
su p0* 
su p1* 
save "D:\david\SAEresearch\Code\STATAcode\MEX\2010\Results\poverty_simulations\simulation_results_pl", replace 
*/ 

use "D:\david\SAEresearch\Code\STATAcode\MEX\2010\Results\poverty_simulations\simulation_results_pl", replace 
gen id=1 
reshape long p0_ p1_, i(id) j(both) string
gen threshold=real(substr(both,-2,.))
gen method=substr(both,1,strpos(both,"__")-1)
replace method="baseline" if both=="baseline" 
drop id both 
rename p0_ p0 
rename p1_ p1 

gen ebp_unit=p1 if method=="ebp_unit" 
egen p1_ebp_unit=max(ebp_unit),by(threshold)
gen baseline=p1 if method=="baseline" 
egen p1_baseline=max(baseline)
drop ebp_unit baseline 

gen poverty_reduction_penalty=1-(p1_baseline-p1)/(p1_baseline-p1_ebp_unit)


sort threshold method 
drop if method=="true"
export excel using "D:\david\SAEresearch\Code\STATAcode\MEX\2010\Results\poverty_simulations\simulation_results.xlsx", replace firstrow(variables) 
* graph bar p0, over(method) by(threshold)

 




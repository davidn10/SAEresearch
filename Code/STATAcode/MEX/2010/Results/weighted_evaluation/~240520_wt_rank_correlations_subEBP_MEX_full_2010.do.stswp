
clear all
set more off

/*=========================================
 Defining globals
 *=========================================*/

* global currdata "D:\SAE_project\MEX\2010\full_census_new"
global currdata "D:\david\SAE\SAE_research_with_Melany\MEX\2010\full_census_new"

global rawsamples "$currdata\rawsamples_full\"
global census "$currdata\census\"
global results "$currdata\results\results_sub_ebp\"
global simcensus "$currdata\simcensus\"


set seed 648743

/*===================================
=====================================
EBP subarea
=====================================
===================================*/
use "$census\census.dta", clear
bys mun_id: g num_hh=_N
egen pop_mun=sum(popwr), by(mun_id)
keep mun_id num_hh pop_mun 
duplicates drop
tempfile census
save `census'

putexcel set "$results\wt_rankcorr_subEBP_wow", replace

forvalues i=1(1)100 {

/*=========================================
 Identifying in sample and out-of-sample
*=========================================*/
use `census', clear
merge 1:m mun_id using "$rawsamples\selected\sample_`i'.dta"
keep mun_id _merge num_hh pop_mun 
duplicates drop 

g small_mun=(num_hh<500) //small municipalities around 12%
recode _merge (1=0) (3=1)
rename _merge in_sample
tempfile insample
save `insample'

/*=========================================
Rank correlations 
*=========================================*/
use "$results\output_wow\sim_ebp_subebp_`i'.dta", clear
rename area mun_id
destring mean mun_id, replace
rename mean sim_fgt0

merge 1:1 mun_id using `insample'
drop _merge

merge 1:1 mun_id using "$simcensus\true_fg0_full.dta", keepusing(fgt0_m fgt1_m fgt2_m)
keep if _merge==3
drop _merge
rename  fgt0_m fgt0_true
rename  fgt1_m fgt1_true
rename  fgt2_m fgt2_true

merge 1:1 mun_id using "$simcensus\full\direct_fg0_`i'.dta", keepusing(fgt0_m fgt1_m fgt2_m)
drop _merge
rename  fgt0_m fgt0_dir
rename  fgt1_m fgt1_dir
rename  fgt2_m fgt2_dir

merge 1:1 mun_id using "$simcensus\full\direct_resc2_fg0_`i'.dta", keepusing(fgt0_m fgt1_m fgt2_m)
drop _merge
rename  fgt0_m fgt0_dirs
rename  fgt1_m fgt1_dirs
rename  fgt2_m fgt2_dirs

wspearman fgt0_true sim_fgt0 [aw=pop_mun]
local rho_`i'=r(rho)
local N_`i'=r(N)
wspearman fgt0_true sim_fgt0 if in_sample==1 [aw=pop_mun]
local rhoin_`i'=r(rho)
local Nin_`i'=r(N)
wspearman fgt0_true sim_fgt0 if in_sample==0 [aw=pop_mun]
local rhoout_`i'=r(rho)
local Nout_`i'=r(N)
wspearman fgt0_dirs sim_fgt0 [aw=pop_mun]
local rhods_`i'=r(rho)
local Nds_`i'=r(N)
wspearman fgt0_dir fgt0_true [aw=pop_mun]
local rhodt_`i'=r(rho)
local Ndt_`i'=r(N)

***Pearson correlations
corr fgt0_true sim_fgt0 [aw=pop_mun]
local rho2_`i'=r(rho) 
local N2_`i'=r(N)
corr fgt0_true sim_fgt0 if in_sample==1 [aw=pop_mun]
local rhoin2_`i'=r(rho)
local Nin2_`i'=r(N)
corr fgt0_true sim_fgt0 if in_sample==0 [aw=pop_mun]
local rhoout2_`i'=r(rho)
local Nout2_`i'=r(N)
corr fgt0_dirs sim_fgt0  [aw=pop_mun]
local rhods2_`i'=r(rho)
local Nds2_`i'=r(N)
corr fgt0_dir fgt0_true [aw=pop_mun]
local rhodt2_`i'=r(rho)
local Ndt2_`i'=r(N)

putexcel A`i'=`rho_`i''
putexcel B`i'=`rhoin_`i''
putexcel C`i'=`rhoout_`i''
putexcel D`i'=`rhods_`i''
putexcel E`i'=`rhodt_`i''

putexcel G`i'=`N_`i''
putexcel H`i'=`Nin_`i''
putexcel I`i'=`Nout_`i''
putexcel J`i'=`Nds_`i''
putexcel K`i'=`Ndt_`i''

putexcel M`i'=`rho2_`i''
putexcel N`i'=`rhoin2_`i''
putexcel O`i'=`rhoout2_`i''
putexcel P`i'=`rhods2_`i''
putexcel Q`i'=`rhodt2_`i''

putexcel S`i'=`N2_`i''
putexcel T`i'=`Nin2_`i''
putexcel U`i'=`Nout2_`i''
putexcel V`i'=`Nds2_`i''
putexcel W`i'=`Ndt2_`i''

di "`i'"


di "`i'"

}




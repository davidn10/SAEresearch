use "D:\david\SAE\SAE_research_with_Melany\MEX\2010\full_census_new\results\results_error_figure\mae_graph_MEX_2010", replace 
append using "D:\david\SAE\SAE_research_with_Melany\MEX\2015\full_census_new\results\results_error_figure\mae_graph_MEX_2015"
append using "D:\david\SAE\SAE_research_with_Melany\MEX\2020\full_census\results\results_error_figure\mae_graph_MEX_2020"
append using "D:\david\SAE\SAE_research_with_Melany\BRA\2000\full_census\BRA_2000_new\results\results_error_figure\mae_graph_BRA_2000"
append using "D:\david\SAE\SAE_research_with_Melany\BRA\2010\full_census_new\results\results_error_figure\mae_graph_BRA_2010"

gen country_year=country+" "+string(year)

gen sort_order=1 if country=="MEX" 
replace sort_order=2 if country=="BRA" 


graph hbox MAE* if country=="MEX", ylabel(0(0.05)0.4,labsize(small)) ymtick(0(0.01)0.4) name("MAE_MEX", replace) title("Mexico") ytitle("Absolute Error", size(small)) over(year, total sort(sort_order) label(labsize(small)) gap(250) relabel(4 "Total")) legend(position(6) rows(1) size(tiny) order(1 2 3)) ysize(8)
graph hbox MAE* if country=="BRA", ylabel(0(0.05)0.4,labsize(small)) ymtick(0(0.01)0.4) name("MAE_BRA", replace) title("Brazil") ytitle("Absolute Error", size(small)) over(year, total sort(sort_order) label(labsize(small)) gap(250) relabel(3 "Total")) legend(position(6) rows(1) size(tiny) order(4 5 6 7)) ysize(8)

graph combine MAE_MEX MAE_BRA, name(MAE, replace) ysize(8)

graph export mae_box_plot.png, replace
putexcel set "D:\david\SAE\SAE_research_with_Melany\output\tables.xlsx", modify sheet("Figure1")
putexcel A30 = image("mae_box_plot.png")	
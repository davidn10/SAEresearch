*/ 

use "$results\Y_bymun_MEX_2010", replace 

*merge 1:n mun_id sim using "$currdata\results\results_ebp_norescale\leverage_bymun_MEX_2010_s99"


* twoway (scatter mean_y mean_y_true if sim==99) (scatter mean_y mean_y_true if sim==33) (line mean_y mean_y), name(error, replace)




gen error=mean_y-mean_y_true

su error 
su error [aw=popwt]
su error [aw=FACTOR]
su error [aw=FACTOR_resc]
rename TAM_LOC TAMLOC 
local smoother "lpoly"
gen lnpop=log(pop)
local xvar "lnpop"
label var pop "Municipal population"
merge n:1 sim using  "$currdata\results\effective_sample_size\spearman_norescale_MEX_2010", assert(3) nogen 
gen spearmanQ=1 if spearman_>=0.9
replace spearmanQ=2 if spearman_>0.85 & spearman_<0.9
replace spearmanQ=3 if spearman_>0.65 & spearman_<0.85
su spearman_, d
local size "vsmall"
local size2 "small"
local size3 "medsmall"
local hist "fraction"
keep if `xvar'>6 

graph twoway (`smoother' error `xvar' if spearmanQ==1 [aw=FACTOR],yaxis(1) lwidth(medthick)  `options' ) (`smoother' error `xvar' if spearmanQ==2 [aw=FACTOR],yaxis(1) lwidth(medthick) lpattern(dash) lcolor(stc3) `options') (`smoother' error `xvar' if spearmanQ==3 [aw=FACTOR],yaxis(1) lwidth(medthick) lpattern(longdash)  lcolor(stc2) `options')  (hist `xvar' [fw=int(FACTOR)],yaxis(2) fcolor(red%20)  bins(20) `hist') (hist `xvar' [fw=int(FACTOR_resc)],yaxis(2) fcolor(midblue%20) bins(20) `hist')   , name(error_MEX_2010, replace) ytitle("Sampling Error",size(`size2')) ytitle("Fraction", axis(2) size(`size2')) xtitle("Municipal Population (log)",size(`size2')) legend(position(6) rows(2) span colgap(*1.5) label(1 "<0.9<RC<0.95") label(2 "0.85<RC<0.9") label(3 "0.65<RC<0.85") label(4 "Density " "(raw weights)") label(5 "Density" "(rescaled weights)") size(`size'))  title("MEX 2010", size("`size3'")) xlabel(6(2)14,labsize(`size2')) ytitle("Density fraction",size(`size2') axis(2)) saving($results/sampling_error_MEX_2010, replace) ylabel(-0.25(0.05)0.25,labsize(`size2')) ylabel(0(0.05)0.2,labsize(`size2') axis(2))

exit 

*graph twoway   (`smoother' error `xvar' if spearmanT==1,yaxis(1)) (`smoother' error `xvar' if spearmanT==3,yaxis(1)) (kdensity `xvar' [aw=FACTOR] if sim==1, yaxis(2) color(red)) (kdensity `xvar' [w=FACTOR_resc] if sim==1,yaxis(2) fintensity(20)), name(error_2010, replace) ytitle("Sampling Error") xtitle("Log Population") legend(label(1 "Low Correlation") label(2 "Medium Correlation") label(3 "High correlation") label(4 "Density (raw weights)") label(5 "Density (rescaled weights)"))

*twoway (scatter error TAM_LOC if sim==99) (scatter error_33 TAM_LOC if sim==33)
* label var spearman_ "Spearman rank correlation (raw weights)"
*graph twoway (scatter error `xvar',yaxis(1) colorvar(spearman_norescale) colorcuts(0.70(0.05)0.95))  (hist `xvar' [fw=int(FACTOR)],yaxis(2) fcolor(red%20)  bins(20) fraction) (hist `xvar' [fw=int(FACTOR_resc)],yaxis(2) fcolor(midblue%20) bins(20) fraction)   , name(error_2010, replace) ytitle("Sampling Error") xtitle("Log Population") legend(label(1 "Sampling Error") label(2 "Density (raw weights)") label(3 "Density (rescaled weights)") position(6)) title("MEX 2010")  



rename TAMLOC TAM_LOC 
tempfile mean_norescale 
preserve 
collapse (mean) error_norescale=error TAM_LOC_norescale=TAM_LOC [iw=FACTOR], by(sim)
save `mean_norescale'
restore 
collapse (mean) error_rescaled=error TAM_LOC_rescaled=TAM_LOC [iw=FACTOR_resc], by(sim)
merge 1:1 sim using `mean_norescale', assert(3) nogen

save "$results/sampling_error_MEX_2010", replace 

drop _all 
global results "$currdata\results\results_ebp\"
import excel "$results\rankcorr_EBP_unit_h"
keep A 
rename A spearman_rescaled 
drop in 1/3 
gen sim=_n 
save "$currdata\results\effective_sample_size\spearman_rescaled_MEX_2010", replace 

global results "$currdata\results\results_ebp_norescale\"
drop _all 
import excel "$results\rankcorr_EBP_unit_norescale"
keep A 
rename A spearman_norescale 
drop in 1/3 
gen sim=_n 
save "$currdata\results\effective_sample_size\spearman_norescale_MEX_2010", replace 

merge 1:1 sim using "$currdata\results\effective_sample_size\spearman_rescaled_MEX_2010", assert(3) nogen 
merge 1:1 sim using "$currdata\results\effective_sample_size\sampling_error_MEX_2010", assert(3) nogen 


reshape long spearman error TAM_LOC, i(sim) j(scale) string
 

gen rescaled=scale=="_rescaled" 
gen spearman_rescaled=spearman if rescaled==1 
gen spearman_norescale=spearman if rescaled==0 
label var error "Weighted average absolute sampling error"
label var spearman_rescaled "Rescaled weights"
label var spearman_norescale "Raw weights"
global results "$currdata\results\effective_sample_size" 

twoway (scatter spearman_rescaled spearman_norescale error, msymbol(oh X)) (lfit spearman_norescale error,lcolor(red)) (lfit spearman_rescale error, lcolor(blue)),  ylabel(0.65(0.05)0.95) ymtick(0.65(0.01)0.95) legend(position(bottom)) ytitle("Spearman Rank Correlation") saving($results/error_scatter_MEX_2010, replace) legend(order(1 2) rows(1) size(small)) title("Mexico 2010")
table rescaled, statistic(mean error)
su spearman_norescale 

tab rescaled, summ(TAM_LOC)
regress spearman_norescale error if rescaled==0


